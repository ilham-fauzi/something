#!/bin/bash

# 'Something' CLI Wrapper
# Usage: something [start|stop|restart|status|logs]

# Get the real directory of the script, resolving symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"
PID_FILE="$DIR/something.pid"
ENGINE="$DIR/lib/engine.sh"
LOG_FILE="$DIR/logs/something.log"

# Source utilities early to have access to load_config and logging
source "$DIR/lib/utils.sh"
source "$DIR/lib/telegram.sh"

show_help() {
    echo "🛸 Something Framework - CLI v1.1"
    echo "--------------------------------"
    echo "Usage: something <command> [args]"
    echo ""
    echo "🚀 Operations:"
    echo "  start [mod]    Start the engine (all modules or specific one)"
    echo "  stop [mod]     Stop the engine or specific module"
    echo "  restart        Restart the framework"
    echo "  status         Check if engine is running and show uptime"
    echo "  logs           Tail the framework logs"
    echo ""
    echo "⚙️  Configuration:"
    echo "  setup          Run interactive setup wizard"
    echo "  setup -a auto  Fast-track: Auto-detect Chat ID"
    echo "  setup --system Install systemd service (Gatekeeper)"
    echo "  vault <action> Manage encrypted vault (lock|unlock|generate)"
    echo ""
    echo "📦 Module Management:"
    echo "  module list           List installed modules"
    echo "  module install <url|name>  Install module from Git repo or Registry"
    echo "  module update [mod]        Update all or specific module"
    echo "  module remove <mod>        Delete a module"
    echo ""
    echo "🔨 Development:"
    echo "  create -m <name>      Generate boilerplate for new module"
    echo ""
    echo "❓ Misc:"
    echo "  help, --help, -h      Show this help message"
    echo ""
}

manage_vault() {
    local action=$1
    local conf_file="$DIR/config/something.conf"
    local enc_file="$DIR/config/something.conf.enc"

    case "$action" in
        lock)
            if [ ! -f "$conf_file" ]; then
                echo "❌ Error: Plain text config file not found."
                return 1
            fi
            read -s -p "🔑 Create a Master Key to lock your config: " master_key
            echo ""
            if encrypt_file "$conf_file" "$enc_file" "$master_key"; then
                rm "$conf_file"
                log_info "Vault LOCKED: Config encrypted and plaintext deleted"
                echo "✅ Config locked and encrypted. Plain text file deleted."
                echo "💡 Tip: You will need this key to start or setup the application."
            else
                log_error "Vault LOCK FAILED: Encryption error"
                echo "❌ Error: Encryption failed."
            fi
            ;;
        unlock)
            if [ ! -f "$enc_file" ]; then
                echo "❌ Error: Encrypted config file not found."
                return 1
            fi
            read -s -p "🔑 Enter Master Key to unlock: " master_key
            echo ""
            if decrypt_file "$enc_file" "$master_key" > "$conf_file"; then
                chmod 600 "$conf_file"
                log_info "Vault UNLOCKED: Plaintext config restored"
                echo "✅ Config unlocked. Plain text file restored with secure permissions (600)."
            else
                rm -f "$conf_file"
                log_error "Vault UNLOCK FAILED: Incorrect key"
                echo "❌ Error: Decryption failed. Incorrect key?"
            fi
            ;;
        generate)
            local key=$(openssl rand -base64 24)
            echo "🔑 Your New Secure Master Key: $key"
            echo "⚠️  IMPORTANT: Save this key safely! If you lose it, you cannot unlock your vault."
            ;;
        *)
            echo "Usage: something vault {lock|unlock|generate}"
            ;;
    esac
}

# Redundant load_config removed, now uses version from lib/utils.sh

start() {
    local modules=$@
    load_config "$DIR" || return 1

    # Auto-Vaulting: If plaintext config exists alongside encrypted, delete plaintext after load
    if [ -f "$DIR/config/something.conf" ] && [ -f "$DIR/config/something.conf.enc" ]; then
        rm "$DIR/config/something.conf"
        log_info "Auto-Vaulting: Plaintext config deleted after successful load (encrypted version exists)"
        echo "🔒 Auto-Vaulting: Plaintext config deleted for security (loaded into memory)."
    fi

    if [ -f "$PID_FILE" ]; then
        echo "Something is already running (PID: $(cat "$PID_FILE"))"
        return
    fi

    # Handle 'all' or empty arguments
    if [ -z "$modules" ] || [ "$modules" == "all" ]; then
        local enabled_list=$(echo "$ENABLED_MODULES" | tr ',' ' ')
        echo "⚠️  You are about to start ALL enabled modules: $enabled_list"
        read -p "   Continue? (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "❌ Operation cancelled."
            return
        fi
        modules="$enabled_list"
        echo "Starting Something framework (all modules)..."
    else
        echo "Starting Something framework with modules: $modules..."
    fi

    nohup bash "$ENGINE" $modules > /dev/null 2>&1 &
    echo $! > "$PID_FILE"
    echo "Started (PID: $(cat "$PID_FILE"))"
}

stop() {
    if [ ! -f "$PID_FILE" ]; then
        echo "Something is not running."
        return
    fi
    local pid=$(cat "$PID_FILE")
    echo "Stopping Something (PID: $pid)..."
    kill "$pid"
    rm "$PID_FILE"
    echo "Stopped."
}

status() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null; then
            echo "Something is running (PID: $pid)"
            uptime_sec=$(( $(date +%s) - $(stat -c %Y "$PID_FILE") ))
            echo "Uptime: $((uptime_sec / 60)) minutes"
        else
            echo "Something is crashed or not running (stale PID file)."
            rm "$PID_FILE"
        fi
    else
        echo "Something is not running."
    fi
}

create_module() {
    local module_name=$1
    if [ -z "$module_name" ]; then
        echo "Error: Module name is required."
        echo "Usage: something create -m <module_name>"
        return 1
    fi

    # Sanitize module name for filename
    local mod_slug=$(echo "$module_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
    local target_dir="$DIR/modules/$mod_slug"
    local target_file="$target_dir/module.sh"

    if [ -d "$target_dir" ] || [ -f "$DIR/modules/$mod_slug.sh" ]; then
        echo "❌ Error: Module '$mod_slug' already exists."
        return 1
    fi

    mkdir -p "$target_dir"
    echo "Generating template for module: $module_name in $target_dir..."
    
    cat <<EOF > "$target_file"
#!/bin/bash

# Module: $module_name
# Description: Custom monitoring module

module_name="⚡️ $module_name"
module_commands=("/$(echo "$filename" | tr '_' '/')")

# Configuration (Defaults)
# SAMPLE_VAR="\${SAMPLE_VAR:-default_value}"

# Metadata for interactive setup
module_vars=(
    # "SAMPLE_VAR:Description:default_value"
)

# Module Dependencies
# Format: ("cmd:package_name" or "cmd")
module_dependencies=()

module_setup() {
    # Custom setup logic (runs on 'something setup')
    echo "Setting up \$module_name..."
    return 0
}

module_check() {
    # Health check logic
    # Return 0 for OK, 1 for Alert
    # echo "Alert message" if returning 1
    return 0
}

module_handle_command() {
    local cmd=\$1
    case "\$cmd" in
        "/$(echo "$filename" | tr '_' '/')")
            echo "<b>\$module_name</b> is active."
            ;;
    esac
}
EOF


    chmod +x "$target_file"
    echo "✅ Module created: $target_file"
    echo ""
    echo "💡 To finish installation:"
    echo "1. Run setup: something setup --$mod_slug"
    echo "2. Add to ENABLED_MODULES in config/something.conf"
    echo "3. Restart: something restart"
}

manage_modules() {
    local action=$1
    shift
    
    case "$action" in
        install)
            local url=$1
            local alias_flag=$2
            local custom_name=$3
            
            if [ -z "$url" ]; then
                echo "Usage: something module install <url|name> [--as name]"
                return 1
            fi

            # Check if it's a short name from registry
            if [[ ! "$url" =~ ^https?:// ]] && [[ ! "$url" =~ ^git@ ]]; then
                echo "🔍 Checking registry for '$url'..."
                local resolved_url=$(resolve_module_url "$url")
                if [ -n "$resolved_url" ]; then
                    echo "✨ Found in registry: $resolved_url"
                    url="$resolved_url"
                else
                    echo "❌ Error: '$url' is not a URL and was not found in the registry."
                    return 1
                fi
            fi

            # Determine module name
            local mod_name=$(basename "$url" .git)
            if [[ "$alias_flag" == "--as" && -n "$custom_name" ]]; then
                mod_name="$custom_name"
            fi

            local target_dir="$DIR/modules/$mod_name"
            if [ -d "$target_dir" ] || [ -f "$DIR/modules/$mod_name.sh" ]; then
                echo "❌ Error: Module '$mod_name' already exists."
                return 1
            fi

            echo "📦 Installing module '$mod_name' from $url..."
            if git clone "$url" "$target_dir"; then
                echo "✅ Module installed successfully."
                
                # Check for module entry point
                if [ ! -f "$target_dir/module.sh" ]; then
                    echo "⚠️  Warning: No module.sh found in $target_dir. This might not be a valid 'Something' module."
                fi

                echo ""
                echo "💡 To finish installation:"
                echo "1. Run setup: something setup --$mod_name"
                echo "2. Add to ENABLED_MODULES in config/something.conf"
            else
                echo "❌ Error: Failed to clone repository."
                return 1
            fi
            ;;
        list)
            echo "Installed Modules:"
            echo "------------------"
            ls -F "$DIR/modules" | grep -v '.gitignore' | while read -r line; do
                # Remove trailing /, @, or * from ls -F
                local raw_name=$(echo "$line" | sed 's/[/@\*]$//')
                local name="$raw_name"
                local status="[Internal]"
                
                if [[ "$line" == */ ]]; then
                    status="[External]"
                else
                    name="${raw_name%.sh}"
                fi
                echo " - $name $status"
            done
            ;;
        remove)
            local mod_name=$1
            if [ -z "$mod_name" ]; then
                echo "Usage: something module remove <name>"
                return 1
            fi
            
            read -p "❓ Are you sure you want to remove '$mod_name'? (y/n): " confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                rm -rf "$DIR/modules/$mod_name"
                rm -f "$DIR/modules/$mod_name.sh"
                echo "✅ Module '$mod_name' removed."
            fi
            ;;
        update)
            local mod_name=$1
            if [ -z "$mod_name" ]; then
                echo "Updating all external modules..."
                for d in "$DIR/modules"/*/; do
                    if [ -d "$d/.git" ]; then
                        echo "🔄 Updating $(basename "$d")..."
                        (cd "$d" && git pull)
                    fi
                done
            else
                local target="$DIR/modules/$mod_name"
                if [ -d "$target/.git" ]; then
                    echo "🔄 Updating $mod_name..."
                    (cd "$target" && git pull)
                else
                    echo "❌ Error: '$mod_name' is not a git-based module."
                fi
            fi
            ;;
        *)
            echo "Usage: something module {install|remove|list|update}"
            ;;
    esac
}





setup_systemd() {
    # ... (remains same)
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "❌ Error: systemctl not found. This feature is only for Linux systems with systemd."
        return 1
    fi

    local service_file="/etc/systemd/system/something.service"
    local user=$(whoami)
    local gatekeeper_bin="$DIR/bin/something-gatekeeper"

    echo "⚙️  Generating systemd service unit..."
    echo "-----------------------------------"
    echo "User: $user"
    echo "Path: $DIR"

    # Create the service content in a temporary file first
    local temp_service="/tmp/something.service"
    cat <<EOF > "$temp_service"
[Unit]
Description=Something Monitoring Framework Gatekeeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$user
WorkingDirectory=$DIR
ExecStart=/bin/bash $gatekeeper_bin
Restart=on-failure
RestartSec=10
StandardOutput=append:$DIR/logs/gatekeeper.log
StandardError=append:$DIR/logs/gatekeeper.log

[Install]
WantedBy=multi-user.target
EOF

    echo "⚠️  Systemd requires sudo permissions to write to /etc/systemd/system/"
    if sudo mv "$temp_service" "$service_file"; then
        sudo chmod 644 "$service_file"
        echo "✅ Service file created at $service_file"
        
        echo "📡 Reloading systemd daemon..."
        sudo systemctl daemon-reload
        
        echo "🚀 Enabling something.service..."
        sudo systemctl enable something.service
        
        echo ""
        echo "✨ Systemd integration COMPLETED!"
        echo "-----------------------------------"
        echo "The Gatekeeper will now start automatically on boot."
        echo "You can start it now with: sudo systemctl start something"
        echo "Check status with: systemctl status something"
    else
        echo "❌ Failed to create service file. Sudo permission denied?"
        return 1
    fi
}

setup_modules() {
    local target_arg=$1
    shift # Shift to see the rest of arguments
    
    load_config "$DIR" || return 1
    source "$DIR/lib/utils.sh"

    # Handle fast Chat ID addition
    if [[ "$target_arg" == "-a" || "$target_arg" == "--add-chat" ]]; then
        local input_id=$1
        local new_id=""
        
        if [ -z "$input_id" ] || [ "$input_id" == "auto" ]; then
            new_id=$(auto_detect_chat_id)
        else
            new_id="$input_id"
        fi
        
        if [ -n "$new_id" ]; then
            if [ -n "$CHAT_ID" ] && [[ "$CHAT_ID" != "None" ]]; then
                # Check if already exists
                if [[ ",$CHAT_ID," == *",$new_id,"* ]]; then
                    echo "ℹ️  Chat ID $new_id is already in the list."
                else
                    update_conf_val "CHAT_ID" "$CHAT_ID,$new_id"
                    echo "✅ Chat ID $new_id added to authorized list."
                fi
            else
                update_conf_val "CHAT_ID" "$new_id"
                echo "✅ Chat ID $new_id set as authorized user."
            fi
            # Ask for gatekeeper re-config
            configure_gatekeeper
        fi
        return
    fi
    
    if [ -z "$target_arg" ]; then
        echo "⚙️  Core Configuration Setup"
        echo "--------------------------"
        # Check core dependencies
        install_dependencies "curl" "jq"

        # Mandatory sequential config
        sequential_telegram_config

        echo ""
        echo "🛠  Core Variables"
        local core_vars=(
            "CHECK_INTERVAL:Check interval in seconds:60"
            "LOG_FILE:Log file path:$DIR/logs/something.log"
        )
        for var_entry in "${core_vars[@]}"; do
            local key=$(echo "$var_entry" | cut -d':' -f1)
            local desc=$(echo "$var_entry" | cut -d':' -f2)
            local default=$(echo "$var_entry" | cut -d':' -f3)
            local current="${!key}"
            [ -z "$current" ] && current=$default
            
            read -p "   $desc [$current]: " new_val
            if [ -n "$new_val" ]; then
                update_conf_val "$key" "$new_val"
                echo "   ✅ $key updated."
            elif ! grep -q "^[[:space:]]*$key=" "$DIR/config/something.conf"; then
                update_conf_val "$key" "$current"
                echo "   ✅ $key initialized."
            fi
        done

        # Guidance for Gatekeeper
        if [ ! -f "$DIR/config/boot.conf" ]; then
            echo ""
            echo "🛡  Security: Gatekeeper Setup"
            echo "It seems you haven't configured the auto-start Gatekeeper yet."
            echo "This allows you to remotely unlock your framework after a reboot."
            read -p "❓ Would you like to enable Gatekeeper (systemd) now? (y/n) [default: y]: " enable_gk
            if [[ ! "$enable_gk" =~ ^[Nn]$ ]]; then
                setup_systemd
            fi
        fi

        echo ""
        echo "✅ Core setup completed."
        echo "💡 Tip: To setup a specific module, use: something setup --module-name (e.g., --pm2)"
        echo "💡 Tip: To enable auto-start on boot, use: something setup --system"
        return
    fi

    # Handle systemd setup
    if [[ "$target_arg" == "--system" ]]; then
        setup_systemd
        return
    fi

    # Process specific module if argument starts with --
    if [[ "$target_arg" == --* ]]; then
        local module=$(echo "$target_arg" | sed 's/^--//')
        local mod_file="$DIR/modules/$module.sh"
        local mod_dir_file="$DIR/modules/$module/module.sh"
        local mod_path=""

        if [ -f "$mod_file" ]; then
            mod_path="$mod_file"
        elif [ -f "$mod_dir_file" ]; then
            mod_path="$mod_dir_file"
        fi
        
        if [ -z "$mod_path" ]; then
            echo "❌ Error: Module '$module' not found."
            echo "Available modules: $(ls -F "$DIR/modules" | sed 's|[/.*]||g' | sed 's/\.sh//g' | xargs)"
            return 1
        fi

        echo "📦 Setting up module: $module"
        echo "---------------------------"
        
        # Clean up previous module definitions
        unset module_dependencies
        unset -f module_setup
        unset module_vars
        
        source "$mod_path"
        
        # 1. Install defined dependencies
        if [[ "$(declare -p module_dependencies 2>/dev/null)" == "declare -a"* ]]; then
            install_dependencies "${module_dependencies[@]}"
        fi
        
        # 2. Run custom setup if exists (Prefer namespaced)
        if declare -f "${module}_setup" > /dev/null; then
            "${module}_setup"
        elif declare -f module_setup > /dev/null; then
            module_setup
        fi

        # 3. Handle configurable module variables
        if [[ "$(declare -p module_vars 2>/dev/null)" == "declare -a"* ]]; then
            echo "⚙️  Configuring variables..."
            for var_entry in "${module_vars[@]}"; do
                local key=$(echo "$var_entry" | cut -d':' -f1)
                local desc=$(echo "$var_entry" | cut -d':' -f2)
                local default=$(echo "$var_entry" | cut -d':' -f3)
                
                local current="${!key}"
                [ -z "$current" ] && current=$default
                
                read -p "   $desc [$current]: " new_val
                if [ -n "$new_val" ]; then
                    update_conf_val "$key" "$new_val"
                    echo "   ✅ $key updated in config."
                elif ! grep -q "^[[:space:]]*$key=" "$DIR/config/something.conf"; then
                    update_conf_val "$key" "$current"
                    echo "   ✅ $key initialized in config."
                fi
            done
        fi
        echo "✅ Module $module setup completed."
    else
        echo "Usage: something setup [-a <id|auto>|--module-name|--system]"
        return 1
    fi
}

case "$1" in
    start) shift; start "$@" ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    module) shift; manage_modules "$@" ;;
    help|--help|-h) show_help ;;
    create)
        if [ "$2" == "-m" ]; then
            create_module "$3"
        else
            echo "Usage: something create -m <module_name>"
        fi
        ;;
    *) show_help ;;
esac
